    <string notr="true">QWidget {
  background: #1e1e1e;
  color: #d4d4d4;
  font-family: &quot;Segoe UI&quot;, &quot;Noto Sans&quot;, sans-serif;
  font-size: 9pt;
}
QFrame#header, QFrame#activity_bar, QFrame#workspace_panel, QFrame#tools_panel, QFrame#logs_panel {
  background: #252526;
  border: 1px solid #3c3c3c;
}
QTabWidget::pane, QListWidget, QTextEdit, QLineEdit {
  background: #1e1e1e;
  border: 1px solid #3c3c3c;
}
QLabel#label_app_title { color: #ffffff; font-size: 10pt; font-weight: 600; }
QLabel#label_workspace_section, QLabel#label_files_section, QLabel#label_tools,
QLabel#label_logs_section, QLabel#label_progress, QLabel#label_options_section {
  color: #c8c8c8;
  font-weight: 600;
}
QPushButton {
  background: #3c3c3c;
  border: 1px solid #3c3c3c;
  border-radius: 2px;
  padding: 4px 10px;
}
QPushButton:hover { background: #454545; }
QPushButton#compile_btn {
  background: #0e639c;
  border-color: #0e639c;
  color: #ffffff;
  font-weight: 600;
}
QPushButton#compile_btn:hover { background: #1177bb; }
QPushButton#cancel_btn {
  background: #5a1d1d;
  border-color: #6a2a2a;
  color: #f2b8b8;
}
QListWidget { padding: 4px; selection-background-color: #094771; selection-color: #ffffff; }
QTabBar::tab {
  background: #2d2d30;
  border: 1px solid #3c3c3c;
  border-bottom: none;
  padding: 5px 12px;
}
QTabBar::tab:selected { background: #1e1e1e; }
QTabBar::tab:hover { background: #37373d; }
QProgressBar {
  border: 1px solid #3c3c3c;
  text-align: center;
  background: #1e1e1e;
}
QProgressBar::chunk { background: #0e639c; }</string>
