  </property>
  <property name="styleSheet">
   <string notr="true">/* PyCompiler ARK — VSCode inspired */

QWidget {
  background: #1E1E1E;
  color: #D4D4D4;
  font-family: &quot;Segoe UI&quot;, &quot;Noto Sans&quot;, &quot;DejaVu Sans&quot;, Arial, sans-serif;
  font-size: 9pt;
}

QToolTip {
  background-color: #252526;
  color: #D4D4D4;
  border: 1px solid #3C3C3C;
  border-radius: 2px;
  padding: 6px 8px;
}

/* Header */
QFrame#header {
  background: #2D2D30;
  border: 1px solid #3C3C3C;
  border-radius: 0px;
}
QLabel#label_app_title {
  color: #FFFFFF;
  font-weight: 600;
}
QLabel#label_workspace_status {
  color: #C8C8C8;
}

/* Section labels */
QLabel[objectName=&quot;label_workspace_section&quot;],
QLabel[objectName=&quot;label_files_section&quot;],
QLabel[objectName=&quot;label_options_section&quot;],
QLabel[objectName=&quot;label_logs_section&quot;] {
  font-weight: 600;
  font-size: 9pt;
  color: #C8C8C8;
  padding-bottom: 4px;
}
QLabel[objectName=&quot;label_main_actions&quot;],
QLabel[objectName=&quot;label_config_actions&quot;],
QLabel[objectName=&quot;label_tools&quot;],
QLabel[objectName=&quot;label_settings&quot;],
QLabel[objectName=&quot;label_progress&quot;] {
  font-weight: 600;
  font-size: 9pt;
  color: #C8C8C8;
  padding-bottom: 4px;
}

/* Buttons */
QPushButton {
  background: #3C3C3C;
  color: #D4D4D4;
  border: 1px solid #3C3C3C;
  border-radius: 2px;
  padding: 6px 10px;
  font-size: 9pt;
}
QPushButton:hover { background: #454545; border-color: #454545; }
QPushButton:pressed { background: #2A2A2A; }
QPushButton:disabled { color: #8A8A8A; background: #2B2B2B; border-color: #2B2B2B; }

QPushButton#compile_btn {
  background: #0E639C;
  color: #FFFFFF;
  border-color: #0E639C;
  font-weight: 600;
}
QPushButton#compile_btn:hover { background: #1177BB; border-color: #1177BB; }
QPushButton#compile_btn:pressed { background: #0B4F7A; }
QPushButton#cancel_btn {
  background: #5A1D1D;
  color: #F2B8B8;
  border: 1px solid #6A2A2A;
}
QPushButton#cancel_btn:hover { background: #6A2727; border-color: #7A3030; }

/* Checkboxes &amp; Radio */
QCheckBox { color: #D4D4D4; }
QCheckBox::indicator { width: 14px; height: 14px; }
QCheckBox::indicator:unchecked { border: 1px solid #3C3C3C; background: #1E1E1E; }
QCheckBox::indicator:checked { image: none; border: 1px solid #007ACC; background: #007ACC; }

QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #3C3C3C; background: #1E1E1E; border-radius: 7px; }
QRadioButton::indicator:checked { background: #007ACC; border-color: #007ACC; }

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit {
  background: #3C3C3C;
  color: #D4D4D4;
  border: 1px solid #3C3C3C;
  border-radius: 2px;
  padding: 4px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: #007ACC; }

/* Lists &amp; Tables */
QListWidget, QTreeWidget, QTableWidget, QTableView {
  background: #1E1E1E;
  color: #D4D4D4;
  border: 1px solid #3C3C3C;
  border-radius: 0px;
  selection-background-color: #094771;
  selection-color: #D4D4D4;
  padding: 2px;
}
QListWidget::item, QTreeWidget::item { padding: 4px 6px; }
QListWidget::item:hover, QTreeWidget::item:hover { background: #2A2D2E; }
QListWidget::item:selected, QTreeWidget::item:selected { background: #094771; color: #FFFFFF; }

/* Tabs */
QTabWidget::pane { border: 1px solid #3C3C3C; background: #1E1E1E; }
QTabBar { background: #2D2D30; }
QTabBar::tab {
  background: #2D2D30;
  color: #D4D4D4;
  padding: 6px 12px;
  border: 1px solid #3C3C3C;
  border-bottom: none;
}
QTabBar::tab:selected { background: #1E1E1E; border-bottom-color: #1E1E1E; }
QTabBar::tab:hover { background: #37373D; }

/* Progress */
QProgressBar {
  border: 1px solid #3C3C3C;
  border-radius: 0px;
  text-align: center;
  background: #1E1E1E;
  color: #D4D4D4;
  height: 12px;
}
QProgressBar::chunk { background-color: #0E639C; }

/* Combos &amp; Spin */
QComboBox, QSpinBox, QDoubleSpinBox {
  background: #3C3C3C;
  color: #D4D4D4;
  border: 1px solid #3C3C3C;
  border-radius: 2px;
  padding: 4px 6px;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { background: #454545; }
QComboBox QAbstractItemView {
  background: #252526;
  color: #D4D4D4;
  border: 1px solid #3C3C3C;
  selection-background-color: #094771;
  selection-color: #FFFFFF;
  outline: 0;
}

QAbstractSpinBox:focus { border-color: #007ACC; }
QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 20px;
  border-left: 1px solid #3C3C3C;
  background: #2D2D30;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 20px;
  border-left: 1px solid #3C3C3C;
  background: #2D2D30;
}

/* Frames &amp; Groups */
QFrame[frameShape=&quot;4&quot;] {
  background: #252526;
  border: 1px solid #3C3C3C;
  border-radius: 0px;
}
QGroupBox {
  border: 1px solid #3C3C3C;
  border-radius: 0px;
  margin-top: 12px;
  padding-top: 8px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 6px;
  background: transparent;
  color: #D4D4D4;
  font-weight: 600;
}

/* Menus */
QMenuBar { background: #2D2D30; color: #D4D4D4; }
QMenuBar::item:selected { background: #37373D; }
QMenu {
  background: #252526;
  color: #D4D4D4;
  border: 1px solid #3C3C3C;
}
QMenu::item { padding: 6px 12px; }
QMenu::item:selected { background: #094771; }
QMenu::separator { height: 1px; background: #3C3C3C; margin: 6px 8px; }

QStatusBar {
  background: #007ACC;
  color: #FFFFFF;
  border-top: 1px solid #005F9E;
}
QStatusBar::item { border: none; }

/* Scrollbars */
QScrollBar:vertical { background: transparent; width: 12px; margin: 0px; border: none; }
QScrollBar::handle:vertical { background: #3F3F3F; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #4B4B4B; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 0px; border: none; }
QScrollBar::handle:horizontal { background: #3F3F3F; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #4B4B4B; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
</string>
